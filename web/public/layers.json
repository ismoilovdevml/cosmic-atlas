  "layers": [
    {
      "id": "stars-gaia",
      "title": "Gaia DR3 stars",
      "path": "tiles/stars-gaia",
      "visible": true,
      "colorMode": "star",
      "credit": "ESA/Gaia/DPAC, Gaia DR3"
    },
    {
      "id": "stars-gaia-preview",
      "title": "Gaia DR3 stars within 100 pc",
      "path": "tiles/stars-gaia-preview",
      "visible": true,
      "colorMode": "star",
      "preview": true,
      "fallbackFor": "stars-gaia",
      "credit": "ESA/Gaia/DPAC, Gaia DR3; finished download chunks only"
    },
    {
      "id": "galaxies-desi",
      "title": "DESI galaxies",
      "path": "tiles/galaxies-desi",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "DESI Collaboration"
    },
    {
      "id": "galaxies-2mrs",
      "title": "2MASS Redshift Survey",
      "path": "tiles/galaxies-2mrs",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "Huchra et al. 2012"
    },
    {
      "id": "galaxies-cf4",
      "title": "Cosmicflows-4 galaxies",
      "path": "tiles/galaxies-cf4",
      "visible": false,
      "colorMode": "galaxy",
      "credit": "Tully et al. 2023, redshift-independent distances"
    },
    {
      "id": "local-group",
      "title": "Local Group galaxies",
      "path": "tiles/local-group",
      "visible": true,
      "colorMode": "galaxy"
    },
    {
      "id": "local-volume",
      "title": "Local Volume galaxies",
      "path": "tiles/local-volume",
      "visible": true,
      "colorMode": "galaxy",
      "credit": "UNGC, Karachentsev et al. 2013"
    },
    {
      "id": "synthetic-stars",
      "title": "Synthetic stars",
      "path": "tiles/synthetic-stars",
      "visible": true,
      "colorMode": "star",
      "dev": true,
      "fallbackFor": [
        "stars-gaia",
        "stars-gaia-preview"
      ]
    },
    {
      "id": "synthetic-galaxies",
      "title": "Synthetic galaxies",
      "path": "tiles/synthetic-galaxies",
      "visible": true,
      "colorMode": "galaxy",
      "dev": true,
      "fallbackFor": "galaxies-desi"
    },
    {
      "id": "milky-way-model",
      "type": "milky-way-model",
      "title": "Milky Way model",
      "visible": true,
      "credit": "Arms: Reid et al. 2019, ApJ 885, 131; R0 = 8.275 kpc, GRAVITY 2021. A model, not data."
    },
    {
      "id": "dust",
      "type": "dust",
      "title": "3D dust (Edenhofer 2024)",
      "path": "tiles/dust",
      "visible": true,
      "credit": "Edenhofer et al. 2024, A&A 685, A82; Zenodo 10.5281/zenodo.8187943 (CC BY 4.0)"
    },
    {
      "id": "gaia-sky",
      "type": "sky",
      "title": "Gaia all-sky image",
      "visible": true,
      "image": "sky/gaia_dr3_sky_l9.jpg",
      "imageWebp": "sky/gaia_dr3_sky_l9.webp",
      "preview": "sky/gaia_dr3_sky_l9_lo.jpg",
      "credit": "Gaia DR3 integrated flux (ESA/Gaia/DPAC)"
    },
    {
      "id": "star-clusters",
      "title": "Star clusters",
      "path": "tiles/star-clusters",
      "visible": true,
      "colorMode": "star",
      "kind": "cluster",
      "magOffset": 2.5,
      "credit": "Hunt & Reffert 2023, 2024; Baumgardt & Vasiliev 2021. Brightness from mass, colour from age (display only)"
    },
    {
      "id": "gw-volumes",
      "type": "gw-volumes",
      "title": "Gravitational-wave localisations",
      "visible": true,
      "credit": "LIGO/Virgo/KAGRA GWTC via GWOSC and Zenodo (CC BY 4.0); 90 % credible volumes, Planck18 comoving"
    }
